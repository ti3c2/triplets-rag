# Copy to .env and fill in. Loaded via pydantic-settings.

# --- LLM provider keys (set whichever you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- vLLM (optional, for local models) ---
# Default base URL for any local OpenAI-compatible server
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# --- Local OpenAI-compatible embeddings server (TEI, infinity, jina, ...) ---
# Used by embedder configs of kind=openai_compatible.
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=EMPTY

# --- Storage root ---
TRIPLET_RAG_STORAGE_DIR=./storage

# --- Logging ---
TRIPLET_RAG_LOG_LEVEL=INFO

# --- Retry / rate limit behavior ---
TRIPLET_RAG_LLM_MAX_RETRIES=6
TRIPLET_RAG_LLM_RETRY_INITIAL_WAIT=2.0
TRIPLET_RAG_LLM_RETRY_MAX_WAIT=60.0
TRIPLET_RAG_LLM_REQUEST_TIMEOUT=120.0

# --- Concurrency ---
# Also used as the default RAGAS metric-worker limit; eval-ragas --max-workers overrides it.
TRIPLET_RAG_LLM_CONCURRENCY=8
# Optional phase-specific override for teacher question generation.
# Falls back to TRIPLET_RAG_LLM_CONCURRENCY when unset.
TRIPLET_RAG_QUESTION_GEN_CONCURRENCY=
# Optional runtime override. Leave blank to use the embedder config's batch_size.
TRIPLET_RAG_EMBED_BATCH_SIZE=

# --- vLLM lifecycle ---
TRIPLET_RAG_VLLM_HEALTH_TIMEOUT_SEC=300
TRIPLET_RAG_VLLM_GPU_MEMORY_UTILIZATION=0.9
